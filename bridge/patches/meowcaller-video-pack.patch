@@ -0,0 +1,24 @@
+package meowcaller
+
+import "testing"
+
+// WA4S: per-NAL packetization - SPS+PPS in one STAP-A, a small slice alone, a large one as FU-A.
+func TestPackNALUs(t *testing.T) {
+	sps, pps := []byte{0x67, 1, 2, 3}, []byte{0x68, 4}
+	idr := make([]byte, 2000)
+	idr[0] = 0x65
+	out := packNALUs([][]byte{{9, 0xf0}, sps, pps, idr})
+	if len(out) < 4 || out[0][0]&0x1f != 24 {
+		t.Fatalf("first packet %x, want a STAP-A", out[0][:1])
+	}
+	if want := 1 + 2 + len(sps) + 2 + len(pps); len(out[0]) != want {
+		t.Fatalf("STAP-A %d bytes, want %d", len(out[0]), want)
+	}
+	if out[1][0]&0x1f != 28 || out[1][1]&0x1f != 5 || out[1][1]&0x80 == 0 {
+		t.Fatalf("second packet %x, want FU-A start of the IDR", out[1][:2])
+	}
+	small := packNALUs([][]byte{{0x41, 7, 8}})
+	if len(small) != 1 || small[0][0] != 0x41 {
+		t.Fatalf("small slice %x, want it alone", small)
+	}
+}
