+++ b/engine_wa4s_rtcp_test.go	2026-10-25 01:11:09
@@ -0,0 +1,33 @@
+package meowcaller
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/rs/zerolog"
+)
+
+// WA4S: the peer's reception report and NACKs about our video are summed up.
+func TestPeerVideoFeedback(t *testing.T) {
+	const ssrc = 0xabcdef01
+	rr := make([]byte, 8+24+24) // RR, one block, WhatsApp's 24 extra bytes
+	rr[0], rr[1] = 0x80|0x10|1, 201
+	binary.BigEndian.PutUint16(rr[2:], uint16(len(rr)/4-1))
+	binary.BigEndian.PutUint32(rr[8:], ssrc)
+	rr[12] = 64                               // a quarter lost
+	rr[13], rr[14], rr[15] = 0, 0, 9          // 9 lost in all
+	binary.BigEndian.PutUint32(rr[20:], 1234) // jitter
+	nack := make([]byte, 16)
+	nack[0], nack[1] = 0x80|1, 205
+	binary.BigEndian.PutUint16(nack[2:], 3)
+	binary.BigEndian.PutUint32(nack[8:], ssrc)
+	binary.BigEndian.PutUint16(nack[14:], 0x0003) // one packet + two more in the mask
+	f := &peerVideoFeedback{}
+	f.observe(append(rr, nack...), ssrc, zerolog.Nop()) // logs right away (first time) and resets
+	f2 := &peerVideoFeedback{}
+	f2.last = f.last
+	f2.observe(append(rr, nack...), ssrc, zerolog.Nop())
+	if f2.reports != 1 || f2.fractionLost != 64 || f2.cumulativeLost != 9 || f2.jitter != 1234 || f2.nackPackets != 3 {
+		t.Fatalf("got %+v", *f2)
+	}
+}
