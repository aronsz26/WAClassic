[Unit]
Description=WA4S bridge (WhatsApp linked device for the iPhone 4S)
After=network-online.target
Wants=network-online.target

[Service]
User=claude
WorkingDirectory=/home/claude/wa4s
ExecStart=/home/claude/wa4s/wa4s-bridge -listen 127.0.0.1:8097 -tls-listen :25567 -data /home/claude/wa4s/data -assets-auto
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
