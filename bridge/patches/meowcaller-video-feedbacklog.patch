+// peerVideoFeedback sums what the peer's RTCP says about our video (WA4S troubleshooting) and logs it every
+// 5 s: the loss and jitter of its reception report, and how many packets it asked again for (NACK) and how
+// many key frames (PLI/FIR).
+type peerVideoFeedback struct {
+	last                   time.Time
+	reports                int
+	fractionLost, maxLost  int
+	cumulativeLost, jitter uint32
+	nackPackets, plis      int
+}
+
+func (f *peerVideoFeedback) observe(data []byte, videoSsrc uint32, log zerolog.Logger) {
+	for offset := 0; offset+8 <= len(data); {
+		if (data[offset]>>6)&0x03 != 2 {
+			break
+		}
+		n := (int(binary.BigEndian.Uint16(data[offset+2:offset+4])) + 1) * 4
+		if offset+n > len(data) {
+			break
+		}
+		p := data[offset : offset+n]
+		count := int(p[0] & 0x0f) // 0x10 is WhatsApp's profile flag
+		switch p[1] {
+		case 200, 201: // SR, RR: report blocks after the sender info
+			at := 8
+			if p[1] == 200 {
+				at = 28
+			}
+			for i := 0; i < count && at+24 <= len(p); i++ {
+				if binary.BigEndian.Uint32(p[at:]) == videoSsrc {
+					f.reports++
+					f.fractionLost += int(p[at+4])
+					if int(p[at+4]) > f.maxLost {
+						f.maxLost = int(p[at+4])
+					}
+					f.cumulativeLost = binary.BigEndian.Uint32(p[at+4:]) & 0xffffff
+					f.jitter = binary.BigEndian.Uint32(p[at+12:])
+				}
+				at += 24
+			}
+		case 205: // RTPFB: generic NACK, each FCI a packet id and a bitmask of 16 more
+			if p[0]&0x0f == 1 && len(p) >= 12 && binary.BigEndian.Uint32(p[8:]) == videoSsrc {
+				for fci := p[12:]; len(fci) >= 4; fci = fci[4:] {
+					f.nackPackets += 1 + bits.OnesCount16(binary.BigEndian.Uint16(fci[2:]))
+				}
+			}
+		case 206: // PSFB: PLI or FIR
+			if kind := p[0] & 0x0f; (kind == 1 || kind == 4) && len(p) >= 12 {
+				f.plis++
+			}
+		}
+		offset += n
+	}
+	if time.Since(f.last) < 5*time.Second {
+		return
+	}
+	avg := 0
+	if f.reports > 0 {
+		avg = f.fractionLost / f.reports
+	}
+	log.Info().Int("reports", f.reports).Int("avg_lost_256", avg).Int("max_lost_256", f.maxLost).
+		Uint32("cumulative_lost", f.cumulativeLost).Uint32("jitter", f.jitter).Int("nack_packets", f.nackPackets).
+		Int("pli_fir", f.plis).Msg("peer feedback on our video")
+	*f = peerVideoFeedback{last: time.Now(), cumulativeLost: f.cumulativeLost}
+}
 
 // logVideoHeader notes the RTP header of the first video packets each way at info level - header fields and
 // the raw extension only, no payload or keys - to compare what WhatsApp sends with what this client sends.
