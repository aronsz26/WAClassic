+// logVideoHeader notes the RTP header of the first video packets each way at info level - header fields and
+// the raw extension only, no payload or keys - to compare what WhatsApp sends with what this client sends.
+func logVideoHeader(log zerolog.Logger, dir string, n *uint64, h rtp.RtpHeader, raw []byte, payloadBytes int) {
+	if *n >= 150 {
+		return
+	}
+	*n++
+	_, extension, _ := rtp.RtpExtensionProfileAndData(raw)
+	ev := log.Info().Str("dir", dir).Uint16("seq", h.SequenceNumber).Uint32("ts", h.Timestamp).Bool("m", h.Marker).
+		Uint8("pt", h.PayloadType).Int("bytes", payloadBytes).Str("ext", hex.EncodeToString(extension))
+	if x := h.VideoExtension; x != nil {
+		ev = ev.Uint8("mfi", x.MediaFrameInfo).Uint16("bw", x.InitialBandwidth).Int16("off", x.ShortOffset).
+			Uint16("tseq", x.TransportSequence)
+		if x.FrameNumber != nil {
+			ev = ev.Uint16("fn", *x.FrameNumber)
+		}
+	}
+	ev.Msg("video header")
+}
