+func TestH264AccessUnitAssemblerReordersLatePackets(t *testing.T) {
+	var assembler H264AccessUnitAssembler
+	idr := []byte{0x65, 1}
+	p1, p2 := []byte{0x41, 2}, []byte{0x41, 3}
+	if _, ok, _ := assembler.Push(10, true, idr); !ok {
+		t.Fatal("IDR not delivered")
+	}
+	// 12 comes before 11: it waits, then both come out in order without a recovery request
+	if _, ok, rec := assembler.Push(12, true, p2); ok || rec {
+		t.Fatalf("early packet delivered=%v recovery=%v", ok, rec)
+	}
+	first, ok, rec := assembler.Push(11, true, p1)
+	if !ok || rec || first[4] != 0x41 || first[5] != 2 {
+		t.Fatalf("first = %x ok=%v recovery=%v", first, ok, rec)
+	}
+	second, ok := assembler.Next()
+	if !ok || second[5] != 3 {
+		t.Fatalf("second = %x ok=%v", second, ok)
+	}
+	if _, ok := assembler.Next(); ok {
+		t.Fatal("one unit too many")
+	}
+}
+
+func TestH264AccessUnitAssemblerGivesUpOnLostPacket(t *testing.T) {
+	var assembler H264AccessUnitAssembler
+	assembler.Push(0, true, []byte{0x65, 1})
+	recovered := false
+	for seq := uint16(2); seq <= 2+h264ReorderWindow; seq++ { // 1 never comes
+		_, _, rec := assembler.Push(seq, true, []byte{0x41, byte(seq)})
+		recovered = recovered || rec
+	}
+	if !recovered {
+		t.Fatal("no recovery request after the window")
 	}
 }
