-// Push consumes one ordered RTP payload and returns a complete, decodable access
-// unit when the marker closes the frame.
+// h264ReorderWindow is how many later packets may arrive while an earlier one is missing before
+// that one counts as lost.
+const h264ReorderWindow = 10
+
+type heldPacket struct {
+	marker  bool
+	payload []byte
+}
+
+// Push takes one RTP payload in arrival order. A packet that comes early waits for the missing
+// earlier ones (up to h264ReorderWindow later packets); only then the gap counts as loss - over a
+// relay, packets often come slightly out of order. It returns the first access unit that became
+// complete; Next hands out any further ones.
 func (a *H264AccessUnitAssembler) Push(sequence uint16, marker bool, payload []byte) ([]byte, bool, bool) {
+	if d := int16(sequence - a.next); !a.hasNext || d < -1000 || d > 1000 { // first packet, or the sender started over
+		a.held = nil
+		a.next, a.hasNext = sequence, true
+	} else if d < 0 { // late or twice: its place is already taken (or counted as lost)
+		au, ok := a.Next()
+		return au, ok, false
+	}
+	if a.held == nil {
+		a.held = map[uint16]heldPacket{}
+	}
+	a.held[sequence] = heldPacket{marker: marker, payload: append([]byte(nil), payload...)}
+	recoveryNeeded := false
+	for {
+		for {
+			p, ok := a.held[a.next]
+			if !ok {
+				break
+			}
+			delete(a.held, a.next)
+			au, complete, recovery := a.pushOrdered(a.next, p.marker, p.payload)
+			recoveryNeeded = recoveryNeeded || recovery
+			if complete {
+				a.ready = append(a.ready, au)
+			}
+			a.next++
+		}
+		if len(a.held) <= h264ReorderWindow {
+			break
+		}
+		// still missing after a window of later packets: lost; go on with the earliest one held
+		first := true
+		var earliest uint16
+		for s := range a.held {
+			if first || int16(s-a.next) < int16(earliest-a.next) {
+				earliest, first = s, false
+			}
+		}
+		a.next = earliest
+	}
+	au, ok := a.Next()
+	return au, ok, recoveryNeeded
+}
+
+// Next hands out the next access unit that became complete in the last Push, if any.
+func (a *H264AccessUnitAssembler) Next() ([]byte, bool) {
+	if len(a.ready) == 0 {
+		return nil, false
+	}
+	au := a.ready[0]
+	a.ready = a.ready[1:]
+	return au, true
+}
