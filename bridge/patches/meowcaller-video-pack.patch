+// packNALUs packetizes an access unit per NAL unit: leading SPS/PPS aggregated into a STAP-A, every other NAL
+// unit alone or as FU-A fragments. Access unit delimiters are left out.
+func packNALUs(nalus [][]byte) [][]byte {
+	var out [][]byte
+	var stap []byte
+	for _, n := range nalus {
+		if len(n) == 0 || n[0]&0x1f == 9 {
+			continue
+		}
+		if t := n[0] & 0x1f; (t == 7 || t == 8) && len(stap)+2+len(n) <= 800 {
+			if stap == nil {
+				stap = []byte{n[0]&0x60 | 24}
+			}
+			if n[0]&0x60 > stap[0]&0x60 {
+				stap[0] = n[0]&0x60 | 24
+			}
+			stap = append(stap, byte(len(n)>>8), byte(len(n)))
+			stap = append(stap, n...)
+			continue
+		}
+		if stap != nil {
+			out = append(out, stap)
+			stap = nil
+		}
+		out = append(out, rtp.PackageH264NALU(n)...)
+	}
+	if stap != nil {
+		out = append(out, stap)
+	}
+	return out
+}
