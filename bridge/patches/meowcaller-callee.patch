@@ -0,0 +1,22 @@
+package meowcaller
+
+import "testing"
+
+// WA4S: an inbound call dials the relay the caller announced, not the nearest one.
+func TestInboundRelayFollowsCaller(t *testing.T) {
+	rd := &relayData{endpoints: []relayEndpoint{
+		{relayName: "vie1c01", c2rRTT: 20, addresses: []relayAddress{{ipv4: "1.1.1.1", port: 3478}}},
+		{relayName: "fra5c01", c2rRTT: 27, addresses: []relayAddress{{ipv4: "2.2.2.2", port: 3478}}},
+	}}
+	if ep := getMediaRelayEndpoint(rd, true); ep.relayName != "vie1c01" {
+		t.Fatalf("without the caller's relay: %s, want the nearest", ep.relayName)
+	}
+	rd.callerRelay = "fra5c01"
+	if ep := getMediaRelayEndpoint(rd, true); ep.relayName != "fra5c01" {
+		t.Fatalf("with the caller's relay: %s, want fra5c01", ep.relayName)
+	}
+	rd.callerRelay = "ams9c01" // not in the offer: as before
+	if ep := getMediaRelayEndpoint(rd, true); ep.relayName != "vie1c01" {
+		t.Fatalf("unknown caller relay: %s", ep.relayName)
+	}
+}
